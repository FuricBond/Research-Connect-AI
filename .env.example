# ResearchConnect AI — Docker Compose configuration (Phase 6.1)
#
# Copy to `.env` in the repository root and fill in the two REQUIRED values:
#
#   cp .env.example .env
#
# `.env` is git-ignored: never commit real values. Compose reads this file for variable
# substitution, and each container receives only the variables docker-compose.yml passes
# to it, so the frontend never sees the database password or the signing key.
#
# Running the backend directly on the host instead? Use backend/.env.example.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=researchconnect
POSTGRES_USER=researchconnect
# REQUIRED. Use URL-safe characters only (letters, digits and - _ . ~): the password is
# embedded in the backend's connection URL. It takes effect when the database volume is
# first created; changing it afterwards needs `docker compose down -v`, which deletes data.
POSTGRES_PASSWORD=

# ── Backend ───────────────────────────────────────────────────────────────────
# REQUIRED. HS256 signing secret for access tokens, at least 32 characters. With
# APP_ENV=production the backend refuses to start without it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
AUTH_SECRET_KEY=
# development | test | production; any other value is refused. production enforces the
# signing secret, refuses the developer X-User-ID header and the development database
# credentials, and hides the interactive API docs.
APP_ENV=production
# Browser origins allowed to call the API with credentials, as a JSON list.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Honour X-Forwarded-For / X-Real-IP only behind a reverse proxy that overwrites them.
TRUST_PROXY_HEADERS=false
LOG_LEVEL=INFO
# text | json
LOG_FORMAT=text
# Serve the interactive API docs (/docs, /redoc, /openapi.json) even in production.
API_DOCS_ENABLED=false

# ── Background scheduler (Phase 6.3) ──────────────────────────────────────────
# Periodic maintenance: deadline expiry, reminder dispatch, adaptive-signal and governance
# refresh. Off by default. Enable it in one backend process only.
SCHEDULER_ENABLED=false
# Scheduled WikiCFP ingestion makes outbound requests to a third-party site; it runs only
# when this is also true.
SCHEDULER_OPPORTUNITY_REFRESH_ENABLED=false
# Scheduled research refresh: newly published and rising papers from api.openalex.org,
# tagged and embedded. Outbound requests; runs only when SCHEDULER_ENABLED is also true.
SCHEDULER_RESEARCH_REFRESH_ENABLED=false
# Seconds between refreshes: 28800 is every 8 h (28800-36000 for 8-10 h).
SCHEDULER_RESEARCH_REFRESH_INTERVAL_SECONDS=28800
# Comma-separated OpenAlex subfield ids, e.g. 1702 (Artificial Intelligence) or 1702,1707.
RESEARCH_REFRESH_SUBFIELDS=1702
# Corpus cap: at this many research works the refresh stops adding papers but keeps
# updating the ones it has.
RESEARCH_REFRESH_MAX_WORKS=100000
# Optional. Your email for the OpenAlex polite pool.
OPENALEX_EMAIL=
# Optional free OpenAlex API key: ten times the keyless daily budget. Never commit a real key.
OPENALEX_API_KEY=

# ── Email notifications (Phase 5.16) ─────────────────────────────────────────
# mock keeps every email in memory (nothing is sent). smtp emails new notifications through
# the server below, once a minute, and needs SCHEDULER_ENABLED=true.
EMAIL_PROVIDER=mock
# Gmail: smtp.gmail.com, 587, starttls, your address and an app password (Google Account →
# Security → 2-Step Verification → App passwords). Mailtrap's sandbox catches every email
# without delivering it, which is the safest way to try this out.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# Never commit a real password.
SMTP_PASSWORD=
# starttls (port 587), ssl (port 465) or none (a local relay only).
SMTP_SECURITY=starttls
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=ResearchConnect AI
# Who may receive email: comma-separated addresses and @domains, or * for everyone.
# Empty means nobody, so seeded or test accounts are never mailed by accident.
EMAIL_RECIPIENT_ALLOWLIST=
# The web app's address, for the links inside emails.
APP_PUBLIC_URL=http://localhost:3000

# ── Frontend ──────────────────────────────────────────────────────────────────
# The API address as seen from the *browser*, compiled into the frontend at build time:
# changing it requires `docker compose build frontend`. It is public, never a secret.
NEXT_PUBLIC_API_URL=http://localhost:8000
