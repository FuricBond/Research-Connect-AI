# Application Configuration
APP_NAME=ResearchConnect AI
APP_ENV=development

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Authentication & Security Configuration (Phase 6)
# HS256 secret key for signing JWT access tokens (min 32 chars in production)
AUTH_SECRET_KEY=
# Developer identity mode: enables raw X-User-ID header for local testing (MUST be false in production)
AUTH_DEV_IDENTITY_ENABLED=true
# Access token lifetime in minutes
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=480
# bcrypt work factor for password hashing
AUTH_BCRYPT_ROUNDS=12
# Maximum authentication attempts per client per minute
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=10
# Honour X-Forwarded-For / X-Real-IP for client identification. Enable ONLY behind a reverse
# proxy that overwrites these headers, otherwise a caller can rotate them to evade rate limits.
TRUST_PROXY_HEADERS=false

# Structured Logging (Phase 6)
LOG_LEVEL=INFO
# text | json
LOG_FORMAT=text

# Database Configuration (PostgreSQL + pgvector)
DATABASE_URL=postgresql+psycopg://researchconnect:researchconnect@localhost:5432/researchconnect

# Frontend API Endpoint (Next.js — replaces former VITE_API_URL)
NEXT_PUBLIC_API_URL=http://localhost:8000

# OpenAlex API Configuration (Phase 2.2A)
# Base URL for the OpenAlex REST API
OPENALEX_API_BASE_URL=https://api.openalex.org
# Optional: your email address for polite API pool access (faster, more reliable)
OPENALEX_EMAIL=

# Crossref API Configuration (Phase 2.2B)
# Base URL for the Crossref REST API
CROSSREF_API_BASE_URL=https://api.crossref.org
# Optional: your email address for polite pool access
CROSSREF_EMAIL=
# User-Agent string sent with Crossref requests
CROSSREF_USER_AGENT=ResearchConnect-AI/1.0 (https://researchconnect.ai; mailto:info@researchconnect.ai)

# Semantic Embedding Configuration (Phase 2.3B)
# HuggingFace model name for sentence embeddings (384-dim)
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Output dimensionality — must match the model (do not change unless switching model)
EMBEDDING_DIM=384
# Number of texts encoded per batch (trade-off: speed vs memory)
EMBEDDING_BATCH_SIZE=32
# PyTorch device: cpu | cuda | mps
EMBEDDING_DEVICE=cpu
