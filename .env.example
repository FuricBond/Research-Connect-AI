# ResearchConnect AI — Docker Compose configuration (Phase 6.1)
#
# Copy to `.env` in the repository root and fill in the two REQUIRED values:
#
#   cp .env.example .env
#
# `.env` is git-ignored: never commit real values. Compose reads this file for variable
# substitution, and each container receives only the variables docker-compose.yml passes
# to it, so the frontend never sees the database password or the signing key.
#
# Running the backend directly on the host instead? Use backend/.env.example.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=researchconnect
POSTGRES_USER=researchconnect
# REQUIRED. Use URL-safe characters only (letters, digits and - _ . ~): the password is
# embedded in the backend's connection URL. It takes effect when the database volume is
# first created; changing it afterwards needs `docker compose down -v`, which deletes data.
POSTGRES_PASSWORD=

# ── Backend ───────────────────────────────────────────────────────────────────
# REQUIRED. HS256 signing secret for access tokens, at least 32 characters. With
# APP_ENV=production the backend refuses to start without it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
AUTH_SECRET_KEY=
# production enforces the signing secret and refuses the developer X-User-ID header.
APP_ENV=production
# Browser origins allowed to call the API with credentials, as a JSON list.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Honour X-Forwarded-For / X-Real-IP only behind a reverse proxy that overwrites them.
TRUST_PROXY_HEADERS=false
LOG_LEVEL=INFO
# text | json
LOG_FORMAT=text

# ── Frontend ──────────────────────────────────────────────────────────────────
# The API address as seen from the *browser*, compiled into the frontend at build time:
# changing it requires `docker compose build frontend`. It is public, never a secret.
NEXT_PUBLIC_API_URL=http://localhost:8000
