# ResearchConnect AI — backend settings for running the API on the host (not in Docker)
#
# Copy to backend/.env; the backend reads `.env` from its working directory:
#
#   cd backend
#   cp .env.example .env
#
# Every key here must be a backend setting: the settings loader rejects unknown keys at
# startup. For the full Docker stack, use the repository-root .env.example instead.

# Application
APP_NAME=ResearchConnect AI
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL + pgvector). With the Compose database, the password must match
# POSTGRES_PASSWORD in the repository-root .env.
DATABASE_URL=postgresql+psycopg://researchconnect:CHANGE_ME@localhost:5432/researchconnect

# Authentication & security (Phase 6)
# HS256 secret key for signing JWT access tokens (min 32 chars in production)
AUTH_SECRET_KEY=
# Developer identity mode: enables raw X-User-ID header for local testing (MUST be false in production)
AUTH_DEV_IDENTITY_ENABLED=true
# Access token lifetime in minutes
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=480
# bcrypt work factor for password hashing
AUTH_BCRYPT_ROUNDS=12
# Maximum authentication attempts per client per minute
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=10
# Honour X-Forwarded-For / X-Real-IP for client identification. Enable ONLY behind a reverse
# proxy that overwrites these headers, otherwise a caller can rotate them to evade rate limits.
TRUST_PROXY_HEADERS=false

# Structured logging (Phase 6)
LOG_LEVEL=INFO
# text | json
LOG_FORMAT=text

# Background scheduler (Phase 6.3) — off by default; see docs/architecture/phase6-3-scheduler.md
SCHEDULER_ENABLED=false
# Scheduled WikiCFP ingestion (outbound requests); runs only when this is also true
SCHEDULER_OPPORTUNITY_REFRESH_ENABLED=false
SCHEDULER_OPPORTUNITY_REFRESH_TOPIC=artificial intelligence
SCHEDULER_OPPORTUNITY_REFRESH_MAX_PAGES=1
# Seconds between the starts of consecutive runs (minimum 60)
SCHEDULER_OPPORTUNITY_REFRESH_INTERVAL_SECONDS=86400
SCHEDULER_ADAPTIVE_REFRESH_INTERVAL_SECONDS=21600
SCHEDULER_GOVERNANCE_REFRESH_INTERVAL_SECONDS=43200
SCHEDULER_REMINDER_INTERVAL_SECONDS=300
SCHEDULER_DEADLINE_EXPIRY_INTERVAL_SECONDS=3600

# OpenAlex API (Phase 2.2A)
OPENALEX_API_BASE_URL=https://api.openalex.org
# Optional: your email address for polite API pool access (faster, more reliable)
OPENALEX_EMAIL=

# Crossref API (Phase 2.2B)
CROSSREF_API_BASE_URL=https://api.crossref.org
# Optional: your email address for polite pool access
CROSSREF_EMAIL=
CROSSREF_USER_AGENT=ResearchConnect-AI/1.0 (https://researchconnect.ai; mailto:info@researchconnect.ai)

# Semantic embeddings (Phase 2.3B)
# HuggingFace model name for sentence embeddings (384-dim)
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Output dimensionality — must match the model (do not change unless switching model)
EMBEDDING_DIM=384
# Number of texts encoded per batch (trade-off: speed vs memory)
EMBEDDING_BATCH_SIZE=32
# PyTorch device: cpu | cuda | mps
EMBEDDING_DEVICE=cpu
